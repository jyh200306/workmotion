<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 400">
  <defs>
    <filter id="ol" x="-15%" y="-15%" width="130%" height="130%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="e"/>
      <feFlood flood-color="black" flood-opacity="0.85" result="c"/>
      <feComposite in="c" in2="e" operator="in" result="o"/>
      <feMerge><feMergeNode in="o"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g filter="url(#ol)" fill="none" stroke="white" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="100" cy="35" r="28" fill="white" stroke="none"/>
    <line x1="100" y1="63" x2="100" y2="75" stroke-width="16"/>
    <line x1="100" y1="75" x2="100" y2="167" stroke-width="40"/>
    <line x1="82" y1="80" x2="48" y2="140" stroke-width="16"/>
    <line x1="48" y1="140" x2="56" y2="195" stroke-width="14"/>
    <line x1="118" y1="80" x2="152" y2="140" stroke-width="16"/>
    <line x1="152" y1="140" x2="144" y2="195" stroke-width="14"/>
    <line x1="83" y1="170" x2="80" y2="268" stroke-width="22"/>
    <line x1="80" y1="268" x2="75" y2="352" stroke-width="18"/>
    <line x1="58" y1="348" x2="75" y2="352" stroke-width="14"/>
    <line x1="117" y1="170" x2="120" y2="268" stroke-width="22"/>
    <line x1="120" y1="268" x2="125" y2="352" stroke-width="18"/>
    <line x1="125" y1="352" x2="142" y2="348" stroke-width="14"/>
  </g>
</svg>
