<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 400">
  <defs>
    <filter id="ol" x="-15%" y="-15%" width="130%" height="130%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="e"/>
      <feFlood flood-color="black" flood-opacity="0.85" result="c"/>
      <feComposite in="c" in2="e" operator="in" result="o"/>
      <feMerge><feMergeNode in="o"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g filter="url(#ol)" fill="none" stroke="white" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="100" cy="82" r="28" fill="white" stroke="none"/>
    <line x1="100" y1="110" x2="100" y2="122" stroke-width="16"/>
    <line x1="100" y1="122" x2="100" y2="200" stroke-width="40"/>
    <line x1="83" y1="128" x2="50" y2="195" stroke-width="16"/>
    <line x1="50" y1="195" x2="48" y2="245" stroke-width="14"/>
    <line x1="117" y1="128" x2="150" y2="195" stroke-width="16"/>
    <line x1="150" y1="195" x2="152" y2="245" stroke-width="14"/>
    <line x1="83" y1="203" x2="40" y2="282" stroke-width="22"/>
    <line x1="40" y1="282" x2="62" y2="362" stroke-width="18"/>
    <line x1="44" y1="365" x2="76" y2="365" stroke-width="14"/>
    <line x1="117" y1="203" x2="160" y2="282" stroke-width="22"/>
    <line x1="160" y1="282" x2="138" y2="362" stroke-width="18"/>
    <line x1="124" y1="365" x2="156" y2="365" stroke-width="14"/>
  </g>
</svg>
