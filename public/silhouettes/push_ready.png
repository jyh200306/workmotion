<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 400">
  <defs>
    <filter id="ol" x="-15%" y="-15%" width="130%" height="130%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="e"/>
      <feFlood flood-color="black" flood-opacity="0.85" result="c"/>
      <feComposite in="c" in2="e" operator="in" result="o"/>
      <feMerge><feMergeNode in="o"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g filter="url(#ol)" fill="none" stroke="white" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="100" cy="40" r="28" fill="white" stroke="none"/>
    <line x1="100" y1="68" x2="100" y2="80" stroke-width="16"/>
    <line x1="100" y1="80" x2="100" y2="172" stroke-width="40"/>
    <line x1="82" y1="85" x2="36" y2="85" stroke-width="16"/>
    <line x1="36" y1="85" x2="36" y2="42" stroke-width="14"/>
    <line x1="118" y1="85" x2="164" y2="85" stroke-width="16"/>
    <line x1="164" y1="85" x2="164" y2="42" stroke-width="14"/>
    <line x1="83" y1="175" x2="80" y2="275" stroke-width="22"/>
    <line x1="80" y1="275" x2="82" y2="362" stroke-width="18"/>
    <line x1="62" y1="365" x2="94" y2="365" stroke-width="14"/>
    <line x1="117" y1="175" x2="120" y2="275" stroke-width="22"/>
    <line x1="120" y1="275" x2="118" y2="362" stroke-width="18"/>
    <line x1="106" y1="365" x2="138" y2="365" stroke-width="14"/>
  </g>
</svg>
