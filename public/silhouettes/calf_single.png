<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 400">
  <defs>
    <filter id="ol" x="-15%" y="-15%" width="130%" height="130%">
      <feMorphology in="SourceAlpha" operator="dilate" radius="3" result="e"/>
      <feFlood flood-color="black" flood-opacity="0.85" result="c"/>
      <feComposite in="c" in2="e" operator="in" result="o"/>
      <feMerge><feMergeNode in="o"/><feMergeNode in="SourceGraphic"/></feMerge>
    </filter>
  </defs>
  <g filter="url(#ol)" fill="none" stroke="white" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="100" cy="38" r="28" fill="white" stroke="none"/>
    <line x1="100" y1="66" x2="100" y2="78" stroke-width="16"/>
    <line x1="100" y1="78" x2="100" y2="170" stroke-width="40"/>
    <line x1="82" y1="83" x2="48" y2="143" stroke-width="16"/>
    <line x1="48" y1="143" x2="56" y2="198" stroke-width="14"/>
    <line x1="118" y1="83" x2="152" y2="143" stroke-width="16"/>
    <line x1="152" y1="143" x2="144" y2="198" stroke-width="14"/>
    <line x1="83" y1="173" x2="80" y2="272" stroke-width="22"/>
    <line x1="80" y1="272" x2="75" y2="355" stroke-width="18"/>
    <line x1="58" y1="352" x2="75" y2="355" stroke-width="14"/>
    <line x1="117" y1="173" x2="128" y2="228" stroke-width="22"/>
    <line x1="128" y1="228" x2="118" y2="290" stroke-width="18"/>
    <line x1="110" y1="290" x2="130" y2="295" stroke-width="12"/>
  </g>
</svg>
